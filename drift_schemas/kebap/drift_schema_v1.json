          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"muscle_group_id\" INTEGER NOT NULL REFERENCES muscle_groups (id) ON DELETE RESTRICT, \"name_en\" TEXT NOT NULL, \"name_vi\" TEXT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"source_id\" TEXT NULL, \"equipment\" TEXT NULL);"
